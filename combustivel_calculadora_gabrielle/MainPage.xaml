<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="combustivel_calculadora_gabrielle.MainPage"
             BackgroundColor="AntiqueWhite">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="etanol_gasolina.png"
                HeightRequest="200"
                HorizontalOptions="Center" />

            <Label
                Text="Gasolina ou Etanol. Qual combustível compensa mais?"
                TextColor="Black"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />


            <Entry
                x:Name="entryetanol"
                Placeholder="Preço do litro de etanol"
                Keyboard="Numeric" 
                PlaceholderColor="Orange"
                WidthRequest="280" />

            <Entry
                x:Name="entrygasolina"
                Placeholder="Preço do litro de gasolina"
                PlaceholderColor="Orange"
                Keyboard="Numeric" 
                WidthRequest="280" />

            <Entry
                x:Name="entrykminicial"
                Placeholder="Quilometragem inicial"
                PlaceholderColor="Orange"
                Keyboard="Numeric"
                WidthRequest="280" />

            <Entry
                x:Name="entrykmfinal"
                Placeholder="Quilometragem final"
               PlaceholderColor="Orange"
                Keyboard="Numeric"
                WidthRequest="280" />

            <Entry
                x:Name="entrylitrosabastecidos"
                Placeholder="Quantidade de litros abastecidos"
                PlaceholderColor="Orange"
                Keyboard="Numeric" 
                WidthRequest="280" />

            <Button
                x:Name="CalcBtn"
                Text="Calcular"
                TextColor="Black"
                Clicked="OnCounterCalc"
                HorizontalOptions="Center"
                BackgroundColor="Orange"/>
           
            <Label x:Name="Resultlabel" 
                   Text="Compensa abastecer com..."
                   TextColor="Black"
                   FontSize="20"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
